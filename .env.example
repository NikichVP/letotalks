# Copy to .env and fill in real values. NEVER commit .env.

# --- Telegram (модерация комментариев и заявок) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Обязателен в production: без него webhook отклоняется.
TELEGRAM_WEBHOOK_SECRET=

# --- LLM-модерация (OpenAI или совместимый) ---
OPENAI_API_KEY=
# Необязательно: отдельный ключ только для модерации (иначе берётся OPENAI_API_KEY).
GPT_MODERATION_API_KEY=
# Необязательно: кастомный endpoint (по умолчанию https://api.openai.com/v1/responses).
OPENAI_BASE_URL=
GPT_MODERATION_URL=
GPT_MODERATION_MODEL=gpt-5-nano

# --- Приложение ---
# production | development. В production cookie ставится с флагом Secure.
NODE_ENV=development
# Email суперадмина.
ROOT_ADMIN_EMAIL=admin@example.com
# soft | strict — привязка сессии к IP/UA.
SESSION_BINDING_MODE=strict
# Необязательно: путь к файлу БД.
LETOTALKS_DB_PATH=

# --- Исходящий прокси (необязательно) ---
# OUTBOUND_PROXY_URL=http://proxy.example.invalid:8080
