# Copy to .env and fill in real values. NEVER commit .env.

# --- Вход по коду на email (Resend) ---
# API-ключ Resend (https://resend.com). Без него письма не шлются:
# в dev-режиме код входа печатается в консоль сервера.
RESEND_API_KEY=
# Адрес отправителя (домен должен быть верифицирован в Resend).
AUTH_EMAIL_FROM=LetoTalks <noreply@letotalks.com>
# Домены, с которых разрешён вход (через запятую).
ALLOWED_EMAIL_DOMAINS=@student.letovo.ru
# Отдельные разрешённые адреса (через запятую). ROOT_ADMIN_EMAIL разрешён всегда.
ALLOWED_LOGIN_EMAILS=

# --- Telegram (модерация отзывов, жалобы и заявки на учителей) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Обязателен: без него webhook отклоняется (кнопки модерации не работают).
TELEGRAM_WEBHOOK_SECRET=

# --- LLM-модерация (OpenAI или совместимый) ---
OPENAI_API_KEY=
# Необязательно: отдельный ключ только для модерации (иначе берётся OPENAI_API_KEY).
GPT_MODERATION_API_KEY=
# Необязательно: кастомный endpoint (по умолчанию https://api.openai.com/v1/responses).
OPENAI_BASE_URL=
GPT_MODERATION_URL=
GPT_MODERATION_MODEL=gpt-5-nano

# --- Приложение ---
# production | development. В production: Secure-cookie, коды входа не пишутся в лог,
# без работающей почты вход не открывается.
NODE_ENV=development
# Email главного администратора (управляет остальными админами).
ROOT_ADMIN_EMAIL=admin@example.com
# soft | strict — привязка сессии к браузеру (версии браузера не учитываются).
SESSION_BINDING_MODE=strict
# Порт и адрес. HOST=127.0.0.1 — если сервер стоит за nginx на той же машине.
PORT=3001
HOST=
# Кому доверять X-Forwarded-For: «loopback» (nginx на этой же машине), «1» (один
# прокси впереди) и т.п. Пусто: в production — локальные/приватные адреса, иначе никому.
TRUST_PROXY=
# Необязательно: путь к файлу БД и к папке данных (фото заявок, бэкапы).
LETOTALKS_DB_PATH=
LETOTALKS_DATA_DIR=

# --- Исходящий прокси (необязательно) ---
# Через него идут запросы к OpenAI, Telegram и Resend (если они недоступны напрямую).
# Поддерживаются только http:// и https:// прокси.
# OUTBOUND_PROXY_URL=http://proxy.example.invalid:8080
